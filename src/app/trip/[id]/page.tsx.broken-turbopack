  }

  const handleEditSubmit = (data: {
    emoji: string
    title: string
    description: string
    startDate: string
    endDate: string
    wallpaper: string
  }) => {
    if (!trip) return

    setIsEditSubmitting(true)

    const updatedTrip = {
      ...trip,
