        ...(newPlaceNotes && { notes: newPlaceNotes }),
      }
      const updatedPlaces = [...places, newPlace]
      setPlaces(updatedPlaces)
      savePlacesToTrip(updatedPlaces)
      resetPlaceModal()
    }
  }

  const resetPlaceModal = () => {
    searchAbortRef.current?.abort()
    setIsPlaceSearchOpen(false)
    setSearchQuery('')
    setSearchResults([])
    setSearchError(null)
