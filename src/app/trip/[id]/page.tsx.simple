'use client'

import { useState, useEffect } from 'react'
import { useParams } from 'next/navigation'
import { Trip, loadTrips } from '@/lib/storage'

export default function TripDetailSimple() {
  const { id } = useParams()
  const [trip, setTrip] = useState<Trip | null>(null)

  useEffect(() => {
    const trips = loadTrips()
    const found = trips.find(t => t.id === id)
    if (found) setTrip(found)
  }, [id])

  return (
    <div className="min-h-screen bg-background text-on-surface font-body p-4">
      <h1 className="text-2xl font-bold mb-4">Trip Details</h1>
      {trip ? (
        <div>
          <h2 className="text-xl font-semibold">{trip.title}</h2>
          <p className="text-neutral-400">{trip.description}</p>
        </div>
      ) : (
        <p>Loading trip...</p>
      )}
    </div>
  )
}
